# Archivos generados que Flutter (en cada `flutter pub get`) y build_runner
# escriben siempre con saltos de línea LF. Fijarlos a LF evita que Git en
# Windows (core.autocrlf=true, lo habitual) los saque con CRLF y luego los
# marque como modificados sin ningún cambio real.
linux/flutter/generated_plugin_registrant.* text eol=lf
linux/flutter/generated_plugins.cmake text eol=lf
windows/flutter/generated_plugin_registrant.* text eol=lf
windows/flutter/generated_plugins.cmake text eol=lf
macos/Flutter/GeneratedPluginRegistrant.swift text eol=lf
lib/data/db/app_database.g.dart text eol=lf
